# Default provider: DeepSeek.
DEEPSEEK_API_KEY=
FAST_LLM=deepseek:deepseek-v4-flash
SMART_LLM=deepseek:deepseek-v4-flash
STRATEGIC_LLM=deepseek:deepseek-v4-pro

# Alternative providers: configure one key and change all three model values.
# ANTHROPIC_API_KEY=
# FAST_LLM=anthropic:claude-haiku-4-5-20251001
# SMART_LLM=anthropic:claude-sonnet-4-5-20250929
# STRATEGIC_LLM=anthropic:claude-sonnet-4-5-20250929
#
# OPENAI_API_KEY=
# FAST_LLM=openai:gpt-5-mini
# SMART_LLM=openai:gpt-5
# STRATEGIC_LLM=openai:gpt-5

# GPT-Researcher always builds an embedding client for similarity search.
# huggingface runs fully local/free (first run downloads the model, no API
# key needed) so a DeepSeek-only setup doesn't also require OPENAI_API_KEY.
# If you already pay for OpenAI, "openai:text-embedding-3-small" is cheaper
# on disk/RAM and skips the local model download.
EMBEDDING=huggingface:sentence-transformers/all-MiniLM-L6-v2

RETRIEVER=searxng
SEARXNG_URL=http://localhost:8080
SEARXNG_SECRET=replace-with-a-random-secret

MCP_SERVER_NAME=deep-research
RESEARCH_OUTPUT_DIR=./outputs

# Optional remote MCP access (stdio remains the default when unset).
# Generate a token with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
# MCP_BEARER_TOKEN=
